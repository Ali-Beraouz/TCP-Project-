digraph G {
  graph [fontname="Inter", fontsize=11, rankdir=TB, nodesep=0.45, ranksep=0.65, newrank=true, labelloc=t, label=<<B>TCPServer - Class Diagram</B>>, fontsize=16, pad=0.3, bgcolor=white];
  node [shape=plaintext, fontname="Inter", fontsize=10];
  edge [fontname="Inter", fontsize=9, color="#334155", fontcolor="#334155"];
  subgraph cluster_launcher { label=<<B>launcher</B>>; style="rounded,filled"; fillcolor="#FFFBEB"; color="#94A3B8"; fontsize=11; margin=14;
    "TCPServer" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#FDE68A" CELLPADDING="6"><FONT POINT-SIZE="9">«main class»</FONT><BR/><B>TCPServer</B></TD></TR><TR><TD CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ main(args: String[])<BR ALIGN="LEFT"/>- runConsole()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_view { label=<<B>view  (JavaFX + console)</B>>; style="rounded,filled"; fillcolor="#EFF6FF"; color="#94A3B8"; fontsize=11; margin=14;
    "ServerApp" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#BFDBFE" CELLPADDING="6"><FONT POINT-SIZE="9">«JavaFX Application»</FONT><BR/><B>ServerApp</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- server: ChatServer<BR ALIGN="LEFT"/>- view: ServerView<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ start(stage: Stage)<BR ALIGN="LEFT"/>+ stop()<BR ALIGN="LEFT"/>- toggleServer()<BR ALIGN="LEFT"/>- startServer()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ServerView" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#BFDBFE" CELLPADDING="6"><B>ServerView</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- root: GridPane<BR ALIGN="LEFT"/>- users: ObservableList&lt;ConnectedUser&gt;<BR ALIGN="LEFT"/>- logEntries: ObservableList&lt;LogEntry&gt;<BR ALIGN="LEFT"/>- statusDot: Circle<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ showStarted(host, port, lanAddresses)<BR ALIGN="LEFT"/>+ showStopped()<BR ALIGN="LEFT"/>+ addUser(user: ConnectedUser)<BR ALIGN="LEFT"/>+ removeUser(user: ConnectedUser)<BR ALIGN="LEFT"/>+ appendLog(entry: LogEntry)<BR ALIGN="LEFT"/>+ messageRelayed()<BR ALIGN="LEFT"/>+ setOnToggle(action: Runnable)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "FxServerListener" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#BFDBFE" CELLPADDING="6"><B>FxServerListener</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- view: ServerView<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ onLog(entry)  // Platform.runLater<BR ALIGN="LEFT"/>+ onUserJoined(user)<BR ALIGN="LEFT"/>+ onUserLeft(user)<BR ALIGN="LEFT"/>+ onServerStarted(host, port)<BR ALIGN="LEFT"/>+ onServerStopped()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ConsoleServerView" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#BFDBFE" CELLPADDING="6"><B>ConsoleServerView</B></TD></TR><TR><TD CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ onLog(entry: LogEntry)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_model { label=<<B>model  (no JavaFX imports)</B>>; style="rounded,filled"; fillcolor="#ECFDF5"; color="#94A3B8"; fontsize=11; margin=14;
    "ChatServer" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#A7F3D0" CELLPADDING="6"><B>ChatServer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- config: ServerConfig<BR ALIGN="LEFT"/>- listener: ServerListener<BR ALIGN="LEFT"/>- clients: Map&lt;String, ClientHandler&gt;<BR ALIGN="LEFT"/>- workers: ExecutorService  // virtual threads<BR ALIGN="LEFT"/>- serverSocket: ServerSocket<BR ALIGN="LEFT"/>- palette: ColorPalette<BR ALIGN="LEFT"/>- running: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ start()<BR ALIGN="LEFT"/>+ stop()<BR ALIGN="LEFT"/>+ isRunning(): boolean<BR ALIGN="LEFT"/>+ getPort(): int<BR ALIGN="LEFT"/>+ getActiveUsers(): List&lt;ConnectedUser&gt;<BR ALIGN="LEFT"/>~ join(h: ClientHandler, name: String): ConnectedUser<BR ALIGN="LEFT"/>~ handleMessage(h: ClientHandler, text: String)<BR ALIGN="LEFT"/>~ sendUserList(h: ClientHandler)<BR ALIGN="LEFT"/>~ disconnected(h: ClientHandler, byChoice: boolean)<BR ALIGN="LEFT"/>- broadcast(line: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ClientHandler" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#A7F3D0" CELLPADDING="6"><FONT POINT-SIZE="9">«Runnable»</FONT><BR/><B>ClientHandler</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- socket: Socket<BR ALIGN="LEFT"/>- out: BufferedWriter<BR ALIGN="LEFT"/>- writeLock: ReentrantLock<BR ALIGN="LEFT"/>- user: ConnectedUser<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ run()<BR ALIGN="LEFT"/>~ send(line: String)<BR ALIGN="LEFT"/>~ welcome(user, line)<BR ALIGN="LEFT"/>~ requestClose()<BR ALIGN="LEFT"/>~ close()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ServerListener" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#A7F3D0" CELLPADDING="6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>ServerListener</I></B></TD></TR><TR><TD CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ onLog(entry: LogEntry)<BR ALIGN="LEFT"/>+ onServerStarted(host, port)<BR ALIGN="LEFT"/>+ onServerStopped()<BR ALIGN="LEFT"/>+ onUserJoined(user: ConnectedUser)<BR ALIGN="LEFT"/>+ onUserLeft(user: ConnectedUser)<BR ALIGN="LEFT"/>+ onMessageRelayed(sender, text)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ConnectedUser" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#A7F3D0" CELLPADDING="6"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>ConnectedUser</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">name: String<BR ALIGN="LEFT"/>color: String<BR ALIGN="LEFT"/>readOnly: boolean<BR ALIGN="LEFT"/>address: String<BR ALIGN="LEFT"/>joinedAt: LocalTime<BR ALIGN="LEFT"/></TD></TR><TR><TD CELLPADDING="2"> </TD></TR></TABLE>>];
    "LogEntry" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#A7F3D0" CELLPADDING="6"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>LogEntry</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">time: LocalTime<BR ALIGN="LEFT"/>level: Level<BR ALIGN="LEFT"/>message: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ of(level, message): LogEntry<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ColorPalette" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#A7F3D0" CELLPADDING="6"><B>ColorPalette</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- hue: AtomicReference&lt;Double&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ next(): String  // #RRGGBB<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "NetworkInfo" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#A7F3D0" CELLPADDING="6"><FONT POINT-SIZE="9">«utility»</FONT><BR/><B>NetworkInfo</B></TD></TR><TR><TD CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ lanAddresses(): List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_config { label=<<B>config</B>>; style="rounded,filled"; fillcolor="#F8FAFC"; color="#94A3B8"; fontsize=11; margin=14;
    "ServerConfig" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#E2E8F0" CELLPADDING="6"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>ServerConfig</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">host: String<BR ALIGN="LEFT"/>port: int<BR ALIGN="LEFT"/>source: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ load(): ServerConfig<BR ALIGN="LEFT"/>+ fromFile(file: Path)<BR ALIGN="LEFT"/>+ fromProperties(p, source)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_protocol { label=<<B>protocol</B>>; style="rounded,filled"; fillcolor="#F8FAFC"; color="#94A3B8"; fontsize=11; margin=14;
    "Protocol" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#E2E8F0" CELLPADDING="6"><FONT POINT-SIZE="9">«utility»</FONT><BR/><B>Protocol</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ JOIN, MSG, USERS, BYE<BR ALIGN="LEFT"/>+ WELCOME, CHAT, USERLIST, INFO, ERROR<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ encode(type, fields...): String<BR ALIGN="LEFT"/>+ escape(text) / unescape(text)<BR ALIGN="LEFT"/>+ isValidUsername(name): boolean<BR ALIGN="LEFT"/>+ sanitizeUsername(name): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Packet" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#E2E8F0" CELLPADDING="6"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>Packet</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">type: String<BR ALIGN="LEFT"/>payload: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ parse(line): Packet<BR ALIGN="LEFT"/>+ fields(count): String[]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  "TCPServer" -> "ServerApp" [style=dashed, arrowhead=vee, label=" launches "];
  "TCPServer" -> "ConsoleServerView" [style=dashed, arrowhead=vee, label=" --console "];
  "ServerApp" -> "ServerView" [dir=both, arrowtail=diamond, arrowhead=vee];
  "ServerApp" -> "ChatServer" [dir=both, arrowtail=diamond, arrowhead=vee];
  "ServerApp" -> "FxServerListener" [style=dashed, arrowhead=vee, label=" creates "];
  "FxServerListener" -> "ServerView" [arrowhead=vee, label=" updates "];
  "FxServerListener" -> "ServerListener" [style=dashed, arrowhead=onormal, arrowsize=1.1];
  "ConsoleServerView" -> "ServerListener" [style=dashed, arrowhead=onormal, arrowsize=1.1];
  "ChatServer" -> "ServerListener" [arrowhead=vee, label=" notifies "];
  "ChatServer" -> "ClientHandler" [dir=both, arrowtail=diamond, arrowhead=vee, headlabel="0..*", labeldistance=2.0];
  "ChatServer" -> "ColorPalette" [dir=both, arrowtail=diamond, arrowhead=vee];
  "ChatServer" -> "ServerConfig" [arrowhead=vee];
  "ClientHandler" -> "ConnectedUser" [arrowhead=vee, label=" 0..1 "];
  "ChatServer" -> "LogEntry" [style=dashed, arrowhead=vee, label=" creates "];
  "ClientHandler" -> "Packet" [style=dashed, arrowhead=vee, label=" parses "];
  "ChatServer" -> "Protocol" [style=dashed, arrowhead=vee, label=" encodes "];
  "FxServerListener" -> "NetworkInfo" [style=dashed, arrowhead=vee];

}