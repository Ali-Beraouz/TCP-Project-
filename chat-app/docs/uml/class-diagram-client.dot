digraph G {
  graph [fontname="Inter", fontsize=11, rankdir=TB, nodesep=0.45, ranksep=0.65, newrank=true, labelloc=t, label=<<B>TCPClient - Class Diagram</B>>, fontsize=16, pad=0.3, bgcolor=white];
  node [shape=plaintext, fontname="Inter", fontsize=10];
  edge [fontname="Inter", fontsize=9, color="#334155", fontcolor="#334155"];
  subgraph cluster_launcher { label=<<B>launcher</B>>; style="rounded,filled"; fillcolor="#FFFBEB"; color="#94A3B8"; fontsize=11; margin=14;
    "TCPClient" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#FDE68A" CELLPADDING="6"><FONT POINT-SIZE="9">«main class»</FONT><BR/><B>TCPClient</B></TD></TR><TR><TD CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ main(args: String[])  // &lt;ServerIP&gt; &lt;Port&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_view { label=<<B>view  (JavaFX + console)</B>>; style="rounded,filled"; fillcolor="#EFF6FF"; color="#94A3B8"; fontsize=11; margin=14;
    "ClientApp" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#BFDBFE" CELLPADDING="6"><FONT POINT-SIZE="9">«JavaFX Application»</FONT><BR/><B>ClientApp</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- controller: ClientController<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ start(stage: Stage)<BR ALIGN="LEFT"/>+ stop()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ClientController" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#BFDBFE" CELLPADDING="6"><B>ClientController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- config: ClientConfig<BR ALIGN="LEFT"/>- client: ChatClient<BR ALIGN="LEFT"/>- loginView: LoginView<BR ALIGN="LEFT"/>- chatView: ChatView<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ show()<BR ALIGN="LEFT"/>+ shutdown()<BR ALIGN="LEFT"/>- join(name: String)<BR ALIGN="LEFT"/>- send(text: String)<BR ALIGN="LEFT"/>- leaveOrClose()<BR ALIGN="LEFT"/>+ onWelcome(...) / onMessage(...)<BR ALIGN="LEFT"/>+ onUserList(...) / onDisconnected(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "LoginView" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#BFDBFE" CELLPADDING="6"><B>LoginView</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- root: GridPane<BR ALIGN="LEFT"/>- usernameField: TextField<BR ALIGN="LEFT"/>- joinButton: Button<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ setOnJoin(handler: Consumer&lt;String&gt;)<BR ALIGN="LEFT"/>+ setBusy(busy: boolean)<BR ALIGN="LEFT"/>+ showError(message)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ChatView" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#BFDBFE" CELLPADDING="6"><B>ChatView</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- root: GridPane<BR ALIGN="LEFT"/>- messages: VBox<BR ALIGN="LEFT"/>- input: TextArea<BR ALIGN="LEFT"/>- sendButton / leaveButton: Button<BR ALIGN="LEFT"/>- statusDot: Circle<BR ALIGN="LEFT"/>- statusLabel: Label  // Online<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ addMessage(m: ChatMessage)<BR ALIGN="LEFT"/>+ addUserList(users, readOnlyCount)<BR ALIGN="LEFT"/>+ addInfo(text) / addError(text)<BR ALIGN="LEFT"/>+ showOffline(reason)<BR ALIGN="LEFT"/>+ setOnSend / setOnLeave / setOnShowUsers<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "FxClientListener" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#BFDBFE" CELLPADDING="6"><FONT POINT-SIZE="9">«decorator»</FONT><BR/><B>FxClientListener</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- delegate: ClientListener<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ onXxx(...)  // Platform.runLater(delegate::onXxx)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ConsoleClient" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#BFDBFE" CELLPADDING="6"><B>ConsoleClient</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- client: ChatClient<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ run()<BR ALIGN="LEFT"/>+ onMessage(m) ...<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_model { label=<<B>model  (no JavaFX imports)</B>>; style="rounded,filled"; fillcolor="#ECFDF5"; color="#94A3B8"; fontsize=11; margin=14;
    "ChatClient" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#A7F3D0" CELLPADDING="6"><B>ChatClient</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- socket: Socket<BR ALIGN="LEFT"/>- out: BufferedWriter<BR ALIGN="LEFT"/>- listener: ClientListener<BR ALIGN="LEFT"/>- readOnly: boolean<BR ALIGN="LEFT"/>- username: String<BR ALIGN="LEFT"/>- connected: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ connect(host, port, username)<BR ALIGN="LEFT"/>+ send(text): SendResult<BR ALIGN="LEFT"/>+ requestUserList()<BR ALIGN="LEFT"/>+ leave()<BR ALIGN="LEFT"/>+ isConnected(): boolean<BR ALIGN="LEFT"/>- readLoop(in)  // virtual thread<BR ALIGN="LEFT"/>- dispatch(p: Packet)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "SendResult" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#A7F3D0" CELLPADDING="6"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>SendResult</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">SENT<BR ALIGN="LEFT"/>COMMAND<BR ALIGN="LEFT"/>EMPTY<BR ALIGN="LEFT"/>BLOCKED_READ_ONLY<BR ALIGN="LEFT"/>NOT_CONNECTED<BR ALIGN="LEFT"/></TD></TR><TR><TD CELLPADDING="2"> </TD></TR></TABLE>>];
    "ClientListener" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#A7F3D0" CELLPADDING="6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>ClientListener</I></B></TD></TR><TR><TD CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ onWelcome(username, readOnly, color)<BR ALIGN="LEFT"/>+ onMessage(m: ChatMessage)<BR ALIGN="LEFT"/>+ onUserList(users, readOnlyCount)<BR ALIGN="LEFT"/>+ onInfo(text)<BR ALIGN="LEFT"/>+ onError(text)<BR ALIGN="LEFT"/>+ onDisconnected(reason)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ChatMessage" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#A7F3D0" CELLPADDING="6"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>ChatMessage</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">time: String<BR ALIGN="LEFT"/>sender: String<BR ALIGN="LEFT"/>color: String<BR ALIGN="LEFT"/>text: String<BR ALIGN="LEFT"/>mine: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD CELLPADDING="2"> </TD></TR></TABLE>>];
  }
  subgraph cluster_config { label=<<B>config</B>>; style="rounded,filled"; fillcolor="#F8FAFC"; color="#94A3B8"; fontsize=11; margin=14;
    "ClientConfig" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#E2E8F0" CELLPADDING="6"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>ClientConfig</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">host: String<BR ALIGN="LEFT"/>port: int<BR ALIGN="LEFT"/>source: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ resolve(args): ClientConfig  // CLI args, else file<BR ALIGN="LEFT"/>+ load(): ClientConfig<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_protocol { label=<<B>protocol</B>>; style="rounded,filled"; fillcolor="#F8FAFC"; color="#94A3B8"; fontsize=11; margin=14;
    "Protocol" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#E2E8F0" CELLPADDING="6"><FONT POINT-SIZE="9">«utility»</FONT><BR/><B>Protocol</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ JOIN, MSG, USERS, BYE<BR ALIGN="LEFT"/>+ WELCOME, CHAT, USERLIST, INFO, ERROR<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ encode(type, fields...): String<BR ALIGN="LEFT"/>+ escape(text) / unescape(text)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Packet" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#475569" BGCOLOR="white"><TR><TD BGCOLOR="#E2E8F0" CELLPADDING="6"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>Packet</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">type: String<BR ALIGN="LEFT"/>payload: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ parse(line): Packet<BR ALIGN="LEFT"/>+ fields(count): String[]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  "TCPClient" -> "ClientConfig" [style=dashed, arrowhead=vee, label=" validates args "];
  "TCPClient" -> "ClientApp" [style=dashed, arrowhead=vee, label=" launches "];
  "TCPClient" -> "ConsoleClient" [style=dashed, arrowhead=vee, label=" --console "];
  "ClientApp" -> "ClientController" [dir=both, arrowtail=diamond, arrowhead=vee];
  "ClientController" -> "LoginView" [dir=both, arrowtail=diamond, arrowhead=vee];
  "ClientController" -> "ChatView" [dir=both, arrowtail=diamond, arrowhead=vee];
  "ClientController" -> "ChatClient" [dir=both, arrowtail=diamond, arrowhead=vee];
  "ClientController" -> "ClientListener" [style=dashed, arrowhead=onormal, arrowsize=1.1];
  "ClientController" -> "FxClientListener" [style=dashed, arrowhead=vee, label=" wraps itself "];
  "FxClientListener" -> "ClientListener" [style=dashed, arrowhead=onormal, arrowsize=1.1];
  "ConsoleClient" -> "ClientListener" [style=dashed, arrowhead=onormal, arrowsize=1.1];
  "ConsoleClient" -> "ChatClient" [dir=both, arrowtail=diamond, arrowhead=vee];
  "ChatClient" -> "ClientListener" [arrowhead=vee, label=" notifies "];
  "ChatClient" -> "SendResult" [style=dashed, arrowhead=vee, label=" returns "];
  "ChatClient" -> "ChatMessage" [style=dashed, arrowhead=vee, label=" creates "];
  "ChatClient" -> "Packet" [style=dashed, arrowhead=vee, label=" parses "];
  "ChatClient" -> "Protocol" [style=dashed, arrowhead=vee, label=" encodes "];
  "ChatView" -> "ChatMessage" [style=dashed, arrowhead=vee, label=" renders "];

}